                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "    pm.expect(jsonData.usuario.rol).to.eql('HUESPED');",
                  "    pm.collectionVariables.set('tokenHuesped', jsonData.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"huesped.prueba@ejemplo.com\",\n  \"password\": \"Segura123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
