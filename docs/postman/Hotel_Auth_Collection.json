              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios",
              "host": ["{{baseUrl}}"],
              "path": ["api", "usuarios"]
            }
          }
        },
        {
          "name": "4.4 ADMINISTRADOR lista todos los usuarios (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Administrador recibe 200 OK en /api/usuarios', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios",
              "host": ["{{baseUrl}}"],
              "path": ["api", "usuarios"]
            }
          }
        },
        {
          "name": "4.5 HUESPED consulta sus propias reservaciones (200 OK - Filtradas por usuario)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenHuesped}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservas"]
            }
          }
        },
        {
          "name": "4.6 HUESPED intenta cancelar reservación de otro huésped (403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Huésped no puede modificar reservación ajena (403 Forbidden)', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenHuesped}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservas/{{reservaId}}/cancelar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservas", "{{reservaId}}", "cancelar"]
            },
            "description": "Verifica que si {{reservaId}} pertenece a otro huésped, el servidor bloquea la acción con 403 Forbidden."
          }
        }
      ]
    },
    {
      "name": "5. Asistente IA Diferenciado por Rol",
