{
  "info": {
    "_postman_id": "8f2b9e41-5a12-4c9e-b178-9d234a567890",
    "name": "Sistema Hotelero - Autenticación y Manejo de Sesiones",
    "description": "Colección completa de pruebas para la práctica universitaria 'Autenticación y manejo de sesiones'. Incluye pruebas de registro, validación de contraseñas, verificación por correo (token de un solo uso), inicio y cierre de sesión con JWT + lista negra, control de acceso por roles (HUESPED y ADMINISTRADOR) y aislamiento de reservaciones e IA por rol.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "tokenHuesped",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenAdmin",
      "value": "",
      "type": "string"
    },
    {
      "key": "verificationToken",
      "value": "REEMPLAZAR_CON_TOKEN_DEL_CORREO",
      "type": "string"
    },
    {
      "key": "reservaId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Registro y Validación de Datos",
      "item": [
        {
          "name": "1.1 Registro exitoso de Huésped (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Código de estado es 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Rol asignado es siempre HUESPED y verificado=false', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.usuario.rol).to.eql('HUESPED');",
                  "    pm.expect(jsonData.usuario.verificado).to.eql(false);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Pérez Huésped\",\n  \"email\": \"huesped.prueba@ejemplo.com\",\n  \"password\": \"Segura123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "registro"]
            },
            "description": "Registra un nuevo usuario. El servidor asigna siempre el rol HUESPED y verificado=false, y envía el correo de verificación."
          }
        },
        {
          "name": "1.2 Registro con correo duplicado (409 Conflict)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Código de estado es 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Otro Usuario\",\n  \"email\": \"huesped.prueba@ejemplo.com\",\n  \"password\": \"Segura123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "registro"]
            }
          }
        },
        {
          "name": "1.3 Registro con contraseña débil o correo inválido (400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Código de estado es 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"\",\n  \"email\": \"correo-invalido\",\n  \"password\": \"123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "registro"]
            }
          }
        },
        {
          "name": "1.4 Intento de inyección de rol ADMINISTRADOR en registro (Ignorado -> crea HUESPED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('El servidor ignora el campo rol y asigna HUESPED', function () {",
                  "    if (pm.response.code === 201) {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData.usuario.rol).to.eql('HUESPED');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Intento Escalación\",\n  \"email\": \"escalacion@ejemplo.com\",\n  \"password\": \"Segura123\",\n  \"rol\": \"ADMINISTRADOR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "registro"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Verificación de Correo Electrónico",
      "item": [
        {
          "name": "2.1 Login ANTES de verificar correo (403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Código de estado es 403 Forbidden por cuenta no verificada', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"huesped.prueba@ejemplo.com\",\n  \"password\": \"Segura123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "2.2 Reenviar correo de verificación (200 OK)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"huesped.prueba@ejemplo.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/reenviar-verificacion",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "reenviar-verificacion"]
            }
          }
        },
        {
          "name": "2.3 Confirmar token de verificación (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Verificación exitosa (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/verificar?token={{verificationToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verificar"],
              "query": [
                {
                  "key": "token",
                  "value": "{{verificationToken}}"
                }
              ]
            },
            "description": "Reemplaza la variable {{verificationToken}} con el token recibido en el correo electrónico."
          }
        },
        {
          "name": "2.4 Reutilizar el mismo token de verificación (400 Bad Request - Un solo uso)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Token ya utilizado devuelve 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/verificar?token={{verificationToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verificar"],
              "query": [
                {
                  "key": "token",
                  "value": "{{verificationToken}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Inicio de Sesión (JWT) y Errores de Credenciales",
      "item": [
        {
          "name": "3.1 Login con contraseña incorrecta (401 Unauthorized - Mensaje genérico)",
