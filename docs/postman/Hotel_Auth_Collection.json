                  "pm.test('Huésped recibe 403 Forbidden al consultar /api/usuarios', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
