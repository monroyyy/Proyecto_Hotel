                  "    pm.response.to.have.status(401);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.eql('Correo o contraseña incorrectos.');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"huesped.prueba@ejemplo.com\",\n  \"password\": \"ClaveIncorrecta999\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "3.2 Login con correo inexistente (401 Unauthorized - Mismo mensaje genérico)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Código 401 y mismo mensaje genérico', function () {",
                  "    pm.response.to.have.status(401);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.eql('Correo o contraseña incorrectos.');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"no.existe.este.correo@ejemplo.com\",\n  \"password\": \"Segura123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "3.3 Login exitoso como ADMINISTRADOR (Guarda tokenAdmin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login Administrador 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "    pm.expect(jsonData.usuario.rol).to.eql('ADMINISTRADOR');",
                  "    pm.collectionVariables.set('tokenAdmin', jsonData.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@hotel.com\",\n  \"password\": \"AdminHotel2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "3.4 Login exitoso como HUESPED verificado (Guarda tokenHuesped)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
