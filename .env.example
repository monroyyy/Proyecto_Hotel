# ==============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (SIN SECRETOS)
# Copie este archivo a ".env" y configure sus valores reales localmente.
# ==============================================================================

# Base de Datos MySQL (usar siempre serverTimezone=America/Mexico_City)
DB_URL=jdbc:mysql://localhost:3306/hotel_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Mexico_City
DB_USERNAME=
DB_PASSWORD=

# Scheduler automático de expiración / No-Show (false por defecto)
APP_JOBS_EXPIRACION_ENABLED=false
# Modo dry-run (solo log, sin modificar BD; mantener true antes de habilitar ejecución real)
APP_JOBS_EXPIRACION_DRY_RUN=true

# Seguridad JWT (al menos 32 caracteres / 256 bits)
JWT_SECRET=
JWT_EXPIRATION_MS=

# Servidor de Correo SMTP (Gmail con Contraseña de Aplicación de 16 caracteres)
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# URL del Frontend y Expiración del Token de Verificación de Correo
APP_FRONTEND_URL=
VERIFICATION_TOKEN_EXPIRATION_MINUTES=

# Cuenta Inicial de Administrador (creada automáticamente al iniciar si no existe)
ADMIN_INITIAL_NAME=
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Orígenes permitidos por CORS (separados por coma)
CORS_ALLOWED_ORIGINS=

# Proxy confiable para leer X-Forwarded-For en rate limiting (false por defecto -> usa remoteAddr)
APP_SECURITY_TRUST_FORWARDED_HEADERS=false
APP_SECURITY_TRUSTED_PROXIES=

# Dominios permitidos para URLs https de imágenes de hoteles y categorías
APP_MEDIA_ALLOWED_IMAGE_DOMAINS=images.unsplash.com

# Configuración de IA (Spring AI)
GEMINI_API_KEY=
OLLAMA_BASE_URL=
